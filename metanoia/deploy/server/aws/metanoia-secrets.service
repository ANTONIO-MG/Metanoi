# Documented in metanoia/docs/reference/deployment.md

[Unit]
Description=Metanoia Group secrets (AWS Secrets Manager -> /run)
After=network-online.target
Wants=network-online.target
Before=metanoia.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/ubuntu/projects/Metanoia/metanoia/deploy/server/aws/fetch-secrets.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
