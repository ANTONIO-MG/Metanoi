# Documented in metanoia/docs/reference/deployment.md

[Unit]
Description=Metanoia Group time-sensitive jobs (quick tick)
After=network-online.target postgresql@16-main.service redis-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/Metanoia/metanoia
ExecStart=/home/ubuntu/projects/Metanoia/metanoia/.environment/bin/python manage.py run_scheduled_jobs --job session-reminders,send-broadcasts,shop-bookings,auto-notices,mail-sync

TimeoutStartSec=600

Nice=15
IOSchedulingClass=idle
CPUWeight=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
