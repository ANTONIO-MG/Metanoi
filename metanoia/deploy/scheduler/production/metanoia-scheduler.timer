# Documented in metanoia/docs/reference/deployment.md

[Unit]
Description=Hourly Metanoia Group background jobs (06:05-22:05 SAST)

[Timer]
OnCalendar=*-*-* 06..22:05:00 Africa/Johannesburg
RandomizedDelaySec=60
AccuracySec=30s
Persistent=true
Unit=metanoia-scheduler.service

[Install]
WantedBy=timers.target
