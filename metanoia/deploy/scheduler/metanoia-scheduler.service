# Documented in metanoia/docs/reference/deployment.md

[Unit]
Description=Metanoia Group background jobs (one tick)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=metanoia
Group=metanoia
WorkingDirectory=/srv/metanoia/metanoia
ExecStart=/srv/metanoia/.venv/bin/python manage.py run_scheduled_jobs

TimeoutStartSec=900

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/metanoia/metanoia/media /srv/metanoia/metanoia/backups

[Install]
WantedBy=multi-user.target
